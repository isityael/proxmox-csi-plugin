{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges",
    ":gitSignOff"
  ],
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "github-actions",
    "woodpecker"
  ],
  "packageRules": [
    {
      "description": "Keep luthermonson/go-proxmox compatible with the upstream wrapper",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/luthermonson/go-proxmox"
      ],
      "allowedVersions": "<=0.5.1"
    },
    {
      "description": "Keep the upstream go-proxmox wrapper on its compatible API",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/sergelogvinov/go-proxmox"
      ],
      "allowedVersions": "<=0.2.0"
    },
    {
      "description": "Keep client-go on the Kubernetes v0.x module line",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/client-go"
      ],
      "allowedVersions": "<1"
    },
    {
      "description": "Group all GitHub Actions into a single PR",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge patch and minor Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Kubernetes 0.37.1 uses structured-merge-diff/v6; newer kube-openapi requires v7 and fails compilation. Revisit with a compatible Kubernetes module update.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/kube-openapi"
      ],
      "allowedVersions": "<=v0.0.0-20260821135717-be32def86098"
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    },
    {
      "description": "YAML v4 requires a coordinated source import migration; retain v3 updates until that migration is implemented and tested.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go.yaml.in/yaml/v3"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
